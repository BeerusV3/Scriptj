local function isValuable(o)
    if not(o:IsA("BasePart")or o:IsA("Model"))then return false end
    local n=o.Name
    if n:find("HumanoidRootPart")or n=="Head"or n=="Torso"or n=="UpperTorso"or n=="LowerTorso"then return false end
    if NC[n]~=nil then return NC[n]end
    local s=n:lower();local ok=false
    for k in pairs(BK)do if s:find(k,1,true)then NC[n]=false;return false end end
    for k in pairs(VK)do if s:find(k,1,true)then ok=true;break end end
    if not ok and o.Parent and o.Parent~=WS then local p=o.Parent.Name:lower();for k in pairs(VK)do if p:find(k,1,true)then ok=true;break end end end
    NC[n]=ok;return ok
end

local HL,BB,HT={},{},{}
local MAX_I,MAX_M,RAD=200,100,500

local function rem(o)
    if HL[o]then HL[o]:Destroy();HL[o]=nil end
    if BB[o]then BB[o]:Destroy();BB[o]=nil end
    HT[o]=nil
end
local function clr()for o in pairs(HL)do rem(o)end end

local function add(o,col,label,typ)
    if HL[o]or not o.Parent then return end
    local hrp=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local part=o:IsA("Model")and(o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart"))or(o:IsA("BasePart")and o)
    if not part or(hrp and(part.Position-hrp.Position).Magnitude>RAD)then return end
    local h=Instance.new("Highlight",o);h.Name="phatv1_hl";h.FillColor=col;h.OutlineColor=col;h.FillTransparency=.6;h.Adornee=o
    local b=Instance.new("BillboardGui",o);b.Name="phatv1_bb";b.Size=UDim2.new(0,140,0,18);b.StudsOffset=Vector3.new(0,2.5,0);b.AlwaysOnTop=true;b.Adornee=o:FindFirstChild("Head")or part
    local t=Instance.new("TextLabel",b);t.Size=UDim2.new(1,0,1,0);t.BackgroundTransparency=1;t.Text=label or o.Name;t.TextColor3=col;t.TextStrokeTransparency=0;t.Font=Enum.Font.GothamBold;t.TextSize=12
    HL[o]=h;BB[o]=b;HT[o]=typ
end

local function getChar(p)local c=p.Character;if c and c:FindFirstChild("HumanoidRootPart")and c:FindFirstChildOfClass("Humanoid")and c:FindFirstChildOfClass("Humanoid").Health>0 then return c end end
local function isAlly(p)return p.Team and LP.Team and p.Team==LP.Team end

function refresh()
    if not C.esp then clr();return end
    local hrp=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for o in pairs(HL)do
        local t=HT[o]
        local bad=not o.Parent
        if not bad then
            if t=="mob"and not C.mobs then bad=true
            elseif t=="item"and not C.items then bad=true
            elseif t=="player"and not C.players then bad=true
            elseif t=="ally"and not C.allies then bad=true
            else
                local h=o:FindFirstChildOfClass("Humanoid")
                if h and h.Health<=0 then bad=true
                elseif hrp then
                    local p=o.PrimaryPart or o:FindFirstChildWhichIsA("BasePart")
                    if p and(p.Position-hrp.Position).Magnitude>RAD then bad=true end
                end
            end
        end
        if bad then rem(o)end
    end
    if C.players then
        local n=0
        for _,p in ipairs(Players:GetPlayers())do
            if p~=LP and n<20 then
                local ch=getChar(p)
                if ch then
                    n=n+1
                    if isAlly(p)then
                        if C.allies then add(ch,Color3.fromRGB(0,255,0),"[ALLY] "..p.Name,"ally")end
                    else
                        add(ch,Color3.fromRGB(255,50,50),p.Name,"player")
                    end
                end
            end
        end
    end
    local nm,ni=0,0
    for _,o in ipairs(WS:GetDescendants())do
        if not HL[o]then
            if C.mobs and nm<MAX_M and o:IsA("Model")then
                local h=o:FindFirstChildOfClass("Humanoid")
                if h and h.Health>0 and not Players:GetPlayerFromCharacter(o)and o~=LP.Character then
                    nm=nm+1
                    add(o,Color3.fromRGB(255,0,0),o.Name,"mob")
                end
            end
            if C.items and ni<MAX_I and isValuable(o)then
                ni=ni+1
                add(o,Color3.fromRGB(255,215,0),o.Name,"item")
            end
        end
    end
end

