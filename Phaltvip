-- ============ KILL AURA ============
local kaCd=0
local function getEquippedTool()
    local ch=LP.Character
    if not ch then return nil end
    return ch:FindFirstChildOfClass("Tool")
end

local function tryEquipTool()
    local ch=LP.Character
    if not ch then return end
    local hum=ch:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local bp=LP:FindFirstChild("Backpack")
    if not bp then return end
    for _,t in ipairs(bp:GetChildren())do
        if t:IsA("Tool")then
            pcall(function() hum:EquipTool(t) end)
            return
        end
    end
end

local function findTarget(hrp)
    local nearest,nd=nil,C.kaR
    for _,m in ipairs(WS:GetDescendants())do
        if m:IsA("Model")then
            local h=m:FindFirstChildOfClass("Humanoid")
            if h and h.Health>0 and not Players:GetPlayerFromCharacter(m) and m~=LP.Character then
                local p=m.PrimaryPart or m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head")
                if p then
                    local d=(p.Position-hrp.Position).Magnitude
                    if d<nd then nd=d;nearest=m end
                end
            end
        end
    end
    return nearest
end

local function fireAttack(tool,targetPart)
    -- 1. Tool.Activate
    pcall(function() tool:Activate() end)
    -- 2. Mô phỏng mouse click (nhiều tool dùng MouseButton1)
    pcall(function()
        VIM:SendMouseButtonEvent(0,0,0,true,game,1)
        task.wait(0.01)
        VIM:SendMouseButtonEvent(0,0,0,false,game,1)
    end)
    -- 3. Xoay về target để tool handle quét trúng
    if targetPart then
        local ch=LP.Character
        local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
        if hrp then
            pcall(function()
                local dir=Vector3.new(targetPart.Position.X-hrp.Position.X,0,targetPart.Position.Z-hrp.Position.Z)
                if dir.Magnitude>0.1 then
                    hrp.CFrame=CFrame.new(hrp.Position,hrp.Position+dir.Unit)
                end
            end)
        end
    end
end

RunService.Heartbeat:Connect(function(dt)
    if not C.ka then return end
    kaCd=kaCd-dt
    if kaCd>0 then return end
    local ch=LP.Character
    if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local tool=getEquippedTool()
    if not tool then
        tryEquipTool()
        return
    end
    
    local target=findTarget(hrp)
    if not target then return end
    
    local tp=target.PrimaryPart or target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Head")
    fireAttack(tool,tp)
    kaCd=C.kaSpd
end)

